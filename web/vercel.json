{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "ignoreCommand": "node scripts/vercel-ignore-build.ts",
  "outputDirectory": "dist",
  "functions": {
    "api/wrinkle-v10.mjs": {
      "maxDuration": 60
    }
  },
  "git": {
    "deploymentEnabled": false
  },
  "github": {
    "autoJobCancelation": true
  },
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/personalized", "destination": "/index.html" },
    { "source": "/v6-review", "destination": "/index.html" },
    { "source": "/current", "destination": "/index.html" },
    { "source": "/current/(.*)", "destination": "/index.html" },
    { "source": "/live", "destination": "/index.html" },
    { "source": "/incision", "destination": "/index.html" },
    { "source": "/annotate", "destination": "/index.html" },
    { "source": "/surgery", "destination": "/index.html" },
    { "source": "/settings/(.*)", "destination": "/index.html" },
    { "source": "/app", "destination": "/index.html" },
    { "source": "/app/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)-([0-9A-Za-z_-]{8,})\\.(js|mjs|css|map)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/assets/(.*)\\.(json|task|bin|obj|wasm)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/(.*)\\.(js|mjs)",
      "headers": [
        { "key": "Content-Type", "value": "text/javascript; charset=utf-8" }
      ]
    }
  ]
}
